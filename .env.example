# Application
PROJECT_NAME="Splitter - Expense Splitter API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
API_PORT=8001

# Security & JWT
SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_CODE_EXPIRE_MINUTES=15
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15

# CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8001

# PostgreSQL Database Configuration
# In Development with Docker, host port is mapped to 5433 to avoid conflict with local postgres (5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=splitter_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/splitter_db

# Redis Configuration (Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Broker and Results Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiting & Spam Protection
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX_FAILED_ATTEMPTS=5
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=600

# SMTP / Email Notifications (Mailpit in development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@splitter.local
EMAILS_FROM_NAME=Splitter App
