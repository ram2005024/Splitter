# ==============================================================================
# SPLITTER — PRODUCTION ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Copy this file to .env on your production EC2 server:
#   cp .env.production.example .env
#
# IMPORTANT: Generate secure random passwords and secrets before launching!
# ==============================================================================

# ── Application Configuration ──────────────────────────────────────────────────
PROJECT_NAME="Splitter"
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
HTTP_PORT=80
API_PORT=8000
FRONTEND_PORT=3000

# Replace 'ram2005024' with your actual GitHub username or organization if changed
GHCR_IMAGE_API=ghcr.io/ram2005024/splitter-api:latest
GHCR_IMAGE_FRONTEND=ghcr.io/ram2005024/splitter-frontend:latest

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_64_char_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_CODE_EXPIRE_MINUTES=15
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15

# Allowed CORS origins (Include your EC2 public IP and/or custom domain)
ALLOWED_ORIGINS=http://your-ec2-ip,http://your-domain.com,https://your-domain.com

# Frontend public API target (Uses relative path /api/v1 when behind Nginx reverse proxy)
NEXT_PUBLIC_API_URL=/api/v1

# ── PostgreSQL Database Configuration (Internal Docker Network) ────────────────
POSTGRES_USER=splitter_user
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=splitter_db
DATABASE_URL=postgresql+asyncpg://splitter_user:generate_a_strong_database_password_here@postgres:5432/splitter_db

# ── Redis Cache & Message Broker (Internal Docker Network) ────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ── Celery Async Workers & Task Queue ─────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
UVICORN_WORKERS=4

# ── Rate Limiting & Abuse Prevention ──────────────────────────────────────────
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX_FAILED_ATTEMPTS=5
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=600

# ── Transactional Email (SMTP Credentials) ────────────────────────────────────
# Supported: Gmail App Password, Resend, SendGrid, Amazon SES, Brevo
#
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=True
#   SMTP_SSL=False
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_16_digit_app_password
#   EMAILS_FROM_EMAIL=your_email@gmail.com
#   EMAILS_FROM_NAME="Splitter"
#
# Example for Resend:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_TLS=True
#   SMTP_SSL=False
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_YourResendApiKey
#   EMAILS_FROM_EMAIL=onboarding@resend.dev
#   EMAILS_FROM_NAME="Splitter"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME="Splitter"
